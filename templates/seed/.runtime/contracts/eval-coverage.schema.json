{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semfs.seed.eval-coverage.schema.json",
  "title": "Eval Coverage Map",
  "type": "object",
  "required": ["schema_version", "coverage"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "eval_coverage.v1"
    },
    "description": { "type": "string" },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_type", "subject_id", "eval_refs"],
        "additionalProperties": false,
        "properties": {
          "subject_type": {
            "type": "string",
            "enum": ["agent", "route", "capability", "suite"]
          },
          "subject_id": { "type": "string" },
          "eval_refs": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-input.schema.json",
  "title": "Agent Input",
  "type": "object",
  "required": ["agent_id", "prompt_ref", "output_contract", "conversation", "policy", "tools"],
  "additionalProperties": false,
  "properties": {
    "agent_id": { "type": "string" },
    "prompt_ref": { "type": "string" },
    "output_contract": { "type": "string" },
    "identity_context_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conversation": { "type": "object" },
    "policy": { "type": "object" },
    "tools": { "type": "object" },
    "lifecycle": { "type": "object" },
    "identity_authority": { "type": "object" },
    "usage_summary": { "type": "object" },
    "vector_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "vector_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["namespace", "summary", "content_ref", "privacy_class"],
        "additionalProperties": true,
        "properties": {
          "namespace": { "type": "string" },
          "summary": { "type": "string" },
          "content_ref": { "type": "string" },
          "privacy_class": { "type": "string" },
          "source_path": { "type": "string" }
        }
      }
    },
    "compact_context": { "type": "object" }
  }
}

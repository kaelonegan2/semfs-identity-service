{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-credential-request.schema.json",
  "title": "Runtime Credential Request",
  "type": "object",
  "required": ["request_id", "credential_alias", "purpose", "required_scope", "approver_role", "status"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "credential_alias": { "type": "string" },
    "purpose": { "type": "string" },
    "required_scope": { "type": "array", "items": { "type": "string" } },
    "approver_role": { "type": "string" },
    "runtime_private_binding_ref": { "type": "string", "pattern": "^runtime-private://" },
    "status": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gap-record.schema.json",
  "title": "Capability Gap Record",
  "type": "object",
  "required": ["gap_id", "gap_type", "detected_by", "detected_at", "summary", "impact", "recommended_next_step", "status"],
  "additionalProperties": false,
  "properties": {
    "gap_id": { "type": "string" },
    "gap_type": {
      "type": "string",
      "enum": ["missing_tool", "missing_tool_schema", "missing_specialist", "missing_prompt_guidance", "missing_playbook", "missing_authority", "missing_private_context", "missing_offering_definition", "missing_pricing_policy", "missing_credential_binding", "missing_payment_capability", "missing_model_policy"]
    },
    "detected_by": { "type": "string" },
    "detected_at": { "type": "string" },
    "conversation_id": { "type": "string" },
    "route": { "type": "string" },
    "agent_id": { "type": "string" },
    "summary": { "type": "string" },
    "impact": { "type": "string" },
    "recommended_next_step": { "type": "string" },
    "proposal_ref": { "type": "string" },
    "review_role": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["recorded", "proposal_drafted", "pending_approval", "approved", "activated", "rejected", "deferred"]
    }
  }
}

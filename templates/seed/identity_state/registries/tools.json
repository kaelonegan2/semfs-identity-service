      "status": "optional_disabled_until_runtime_enabled",
      "authority": "rate_public_sources_for_draft_knowledge"
    },
    {
      "id": "temporary_public_review_site_create",
      "status": "optional_requires_owner_approval",
      "authority": "create_temporary_review_surface_for_owner_or invited reviewers"
    },
    {
      "id": "survey_result_ingest",
      "status": "optional_requires_owner_approval_for_collection",
      "authority": "ingest survey summaries"
    },
    {
      "id": "credential_binding_request",
      "status": "optional_requires_owner_approval",
      "authority": "prepare safe credential setup request only"
    },
    {
      "id": "payment_provider_binding_request",
      "status": "optional_requires_owner_approval",
      "authority": "prepare safe payment provider setup request only"
    },
    {
      "id": "email_draft_prepare",
      "status": "optional_no_send",
      "authority": "prepare email drafts without sending"
    }

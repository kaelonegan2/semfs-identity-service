  "prohibited_until_approved_or_bound": [
    "live_external_send",
    "live_scheduling",
    "live_payment_request",
    "live_credential_use",
    "live_purchasing_or_spend",
    "automatic_policy_activation",
    "automatic_new_agent_activation",
    "automatic_tool_activation",
    "automatic_specialist_activation"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-request.schema.json",
  "title": "Credential Requirement Request",
  "type": "object",
  "required": ["request_id", "credential_alias", "purpose", "required_scope", "requested_by", "approver_role", "risk_level", "status"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "credential_alias": { "type": "string" },
    "purpose": { "type": "string" },
    "required_scope": { "type": "array", "items": { "type": "string" } },
    "tool_id": { "type": "string" },
    "requested_by": { "type": "string" },
    "approver_role": { "type": "string" },
    "risk_level": { "type": "string" },
    "expiration_or_review": { "type": "string" },
    "runtime_private_binding_ref": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "bound_runtime_private", "rejected", "revoked", "expired"] }
  }
}
